<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.liwncy.jscriptx</groupId>
    <artifactId>jscriptx</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>JScriptX Plugin Framework</name>
    <description>插件式游戏脚本框架</description>

    <modules>
        <module>jscriptx-boot</module>
        <module>jscriptx-core</module>
        <module>jscriptx-plugins</module>
    </modules>

    <properties>
        <revision>0.0.1</revision>
        <java.version>17</java.version>

        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm:ss</maven.build.timestamp.format>

        <ver.vertx>5.0.0.CR5</ver.vertx>
        <ver.lombok>1.18.36</ver.lombok>
        <ver.validator>6.2.5.Final</ver.validator>
        <ver.zxing>3.5.3</ver.zxing>
        <ver.jemoji>1.6.0</ver.jemoji>
        <ver.slf4j>2.0.16</ver.slf4j>
        <ver.picocli>4.7.6</ver.picocli>
        <ver.logback>1.5.12</ver.logback>
        <ver.hutool>5.8.37</ver.hutool>
        <ver.jackson>2.15.4</ver.jackson>
        <ver.junit>5.10.3</ver.junit>
        <ver.javacv>1.5.11</ver.javacv>
        <ver.ffmpeg>7.1</ver.ffmpeg>
        <ver.jsoup>1.19.1</ver.jsoup>
        <ver.polyglot>24.1.1</ver.polyglot>

        <easyj-maven-plugin.version>1.1.5</easyj-maven-plugin.version>

    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- vertx依赖管理 -->
            <dependency>
                <groupId>io.vertx</groupId>
                <artifactId>vertx-stack-depchain</artifactId>
                <version>${ver.vertx}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- hutool-bom，子模块只引入需要的模块即可 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${ver.hutool}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 命令行解析 -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${ver.picocli}</version>
            </dependency>
            <!-- lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${ver.lombok}</version>
                <scope>provided</scope>
            </dependency>

            <!-- 日志依赖 -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${ver.slf4j}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${ver.logback}</version>
            </dependency>

            <!-- 配置文件依赖 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${ver.jackson}</version>
            </dependency>

            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>polyglot</artifactId>
                <version>${ver.polyglot}</version>
            </dependency>

            <!-- 热加载依赖 -->
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>0.10.2</version>
            </dependency>

            <!-- 按键监听依赖（替代JIntellitype） -->
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>5.12.1</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>5.12.1</version>
            </dependency>

            <!-- 单元测试 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${ver.junit}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>me.liwncy.jscriptx.boot.JScriptXBoot</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>